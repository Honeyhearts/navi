# Telegram Bot
TELEGRAM_TOKEN=your-bot-token-from-botfather
FOUNDER_CHAT_ID=your-personal-telegram-chat-id

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-key

# Models (via OpenRouter)
CHAT_MODEL=anthropic/claude-3.5-haiku
QUALITY_MODEL=anthropic/claude-3.5-sonnet

# Limits
DAILY_SPEND_CAP=20
RATE_LIMIT_PER_USER=50
STALE_MESSAGE_SECONDS=300

# Dashboard
DASHBOARD_PORT=8080

# Conference
CONFERENCE_END_TIME=2026-04-12T18:00:00
